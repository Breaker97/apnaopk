# ==========================================================================
# Storify — Environment Variables
# --------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values for your environment.
#   cp .env.example .env
#
# NOTE ON EXTERNAL SERVICE COSTS: Several integrations below rely on
# third-party services that may charge usage fees or require a paid
# subscription. The AI-powered features require an OpenAI API key (billed
# per token by OpenAI), and the payment gateways (Stripe, PayPal, Paystack,
# Razorpay) charge transaction fees per their pricing. Configure only the
# providers you intend to use.
#
# TWO SOURCES OF CONFIG: Integration credentials (payments, OAuth/social login,
# SMTP, SMS, storage, analytics) can be set either here in `.env` OR in the Admin
# panel -> Settings. A value saved in Settings (database) always wins; the
# matching variable below is used as a per-field fallback. This lets you boot
# from `.env` and later override individual fields from the UI.
# ==========================================================================

# --------------------------------------------------------------------------
# Database (required)
# --------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/storify?authSource=admin&retryWrites=true&w=majority
MONGODB_DB_NAME=storify

# Connections one app instance may hold open. Shared by page renders, API
# routes, webhooks and cron, so it caps overall concurrency — when it runs out,
# requests queue and the whole site feels slow. Default 50; raise it if you
# serve a mobile client from the same API or run several instances, keeping
# `instances × this value` under your Mongo plan's connection limit
# (Atlas M0 = 500, M10 = 1500).
# MONGODB_MAX_POOL_SIZE=50

# Whether every app start re-issues `createIndex` for every schema index —
# about 370 commands, sent while the first visitors after a deploy or restart
# are waiting on the same connection pool. Leave it on for the first boot so a
# fresh store gets its indexes. Once the store is set up, set it to `false` in
# production; from then on, run the `pnpm db:migrate` steps that docs/UPGRADE.md
# marks "Required if you set MONGODB_AUTO_INDEX=false" when you upgrade.
# MONGODB_AUTO_INDEX=false

# Log every MongoDB query mongoose issues. `true` prints collection, operation
# and filter; `stack` prints the app code that issued it instead. Development
# only: run it with `next start` to count the round trips a page costs. Never
# set it in production — it is verbose and logs query values.
# MONGOOSE_DEBUG=true

# Where API rate-limit counters live. Default (unset) keeps them in MongoDB so
# a limit means the same thing on every app instance. Set to `memory` only if
# you run exactly one instance and want to skip the per-request database
# round-trip — with two instances an in-process counter doubles the effective
# limit and a caller can dodge it by reaching the other one.
# RATE_LIMIT_STORE=memory

# --------------------------------------------------------------------------
# Authentication — Better Auth (required)
# Generate a random 32+ character secret, e.g. `openssl rand -base64 32`
# --------------------------------------------------------------------------
# REQUIRED: generate your own. A production build refuses to start while this
# is empty, a known placeholder, or shorter than 32 characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --------------------------------------------------------------------------
# OAuth / Social login (optional — also configurable in Settings -> OAuth)
# These only supply credentials. The Admin panel toggle decides whether a
# provider is active, so a provider set here stays off until it is enabled in
# Settings -> Security (otherwise an admin could not turn it off).
# --------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# --------------------------------------------------------------------------
# App configuration (required)
# Multi-vendor marketplace mode is toggled at runtime from
# Admin -> Settings -> Multi-vendor (stored in the database), not via .env.
# --------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Storify
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Set to "true" to enable the PWA / service worker during local development
NEXT_PUBLIC_ENABLE_PWA_IN_DEV=true
# Caps how many parallel workers `pnpm build` may spawn. Unset, the build uses
# one worker per CPU core — fastest, but each worker adds memory on top of
# whatever the machine is already running. Set this (2 is a good value) when
# building on the same server that runs the store, or on any host with 8 GB
# RAM or less; the build takes a little longer but its memory footprint stays
# bounded. See docs/UPGRADE.md -> "Build requirements".
# BUILD_MAX_CPUS=2

# Node's JS-heap cap for `pnpm build`, in MB (default 4096). Raise it only if
# a build dies with "JavaScript heap out of memory" and the machine has RAM to
# spare; on a small VPS prefer adding swap over raising this.
# BUILD_NODE_HEAP_MB=4096

# Upper bound, in MB, that Turbopack's native compiler tries to stay under
# during `pnpm build`. The JS-heap cap above does not cover it — this is the
# piece that keeps growing when a build OOMs a server despite BUILD_MAX_CPUS.
# 6144 is a good value on a host that also runs the store.
# BUILD_TURBOPACK_MEMORY_MB=6144

# Server-side source maps in the production build. Off by default: they add
# ~190 MB to .next/server (and to the Docker image) and around 40 % to compile
# time, and `next start` does not read them. Turn on only to upload maps to an
# error tracker or to read a build-time prerender error against the source.
# BUILD_SOURCE_MAPS=true

# --------------------------------------------------------------------------
# Initial admin account — fallbacks for `pnpm create-admin <email> [password] [name]`.
# The email is always passed on the command line; if the password/name
# arguments are omitted, these values are used instead.
# --------------------------------------------------------------------------
ADMIN_NAME=Admin
ADMIN_PASSWORD=change-me

# --------------------------------------------------------------------------
# OpenAI — powers the AI assistant / AI content tools (optional)
# WARNING: Usage is billed by OpenAI per their API pricing.
# https://openai.com/api/pricing/
# --------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key-here
# Enable the admin Home Page Hero banner generator. Defaults to disabled.
AI_HERO_BANNER_ENABLED=false

# --------------------------------------------------------------------------
# Web Push notifications (optional)
# Generate keys with: `pnpm push:keys`
# --------------------------------------------------------------------------
WEB_PUSH_PUBLIC_KEY=your-web-push-public-key-here
WEB_PUSH_PRIVATE_KEY=your-web-push-private-key-here
WEB_PUSH_SUBJECT=mailto:admin@example.com
# Public key also exposed to the browser
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=your-web-push-public-key-here

# --------------------------------------------------------------------------
# Email / SMTP (required for transactional emails)
# --------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
CRON_SECRET=replace-with-a-long-random-secret
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="Storify <no-reply@example.com>"

# --------------------------------------------------------------------------
# SMS notifications via Twilio (optional) — https://www.twilio.com/sms/pricing
# WARNING: Twilio bills every message, per segment.
# These only supply credentials: SMS stays off until an admin enables it in
# Settings -> SMS and picks events in Settings -> Notifications. Set either a
# Messaging Service SID (recommended) or a From number / sender ID.
# See docs/SMS_NOTIFICATIONS.md.
# --------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+15551234567

# --------------------------------------------------------------------------
# Omnichannel messaging (optional — required for WhatsApp/Messenger API mode)
# Generate MESSAGING_ENCRYPTION_KEY with a cryptographically secure password
# generator (minimum 32 characters). Never rotate it without re-encrypting
# existing channel tokens.
# --------------------------------------------------------------------------
MESSAGING_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
META_APP_SECRET=your-meta-app-secret
META_APP_ID=your-meta-app-id
META_WHATSAPP_CONFIGURATION_ID=your-facebook-login-for-business-configuration-id
# Optional. A SECOND Facebook Login for Business configuration — one that grants
# the Instagram messaging permissions. It is NOT the configuration ID from
# "Instagram > API setup with Instagram login": that product uses a different
# token endpoint and would fail the code exchange. Without this the Instagram
# panel falls back to the manual Page-token form.
META_INSTAGRAM_CONFIGURATION_ID=your-facebook-login-for-business-configuration-id
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-verify-token
# Explicitly pin the Graph version configured for your Meta app, e.g. vXX.X.
META_GRAPH_API_VERSION=vXX.X

# --------------------------------------------------------------------------
# Payment gateways (optional — configure the providers you use)
# WARNING: Each provider charges transaction fees per their pricing.
# --------------------------------------------------------------------------

# Stripe — https://stripe.com/pricing
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# PayPal — https://www.paypal.com/us/webapps/mpp/merchant-fees
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# Paystack — https://paystack.com/pricing
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx

# Pesapal API 3.0
PESAPAL_MODE=sandbox
PESAPAL_CONSUMER_KEY=your-pesapal-consumer-key
PESAPAL_CONSUMER_SECRET=your-pesapal-consumer-secret
PESAPAL_IPN_ID=your-registered-pesapal-ipn-id

# ioTec Pay — https://pay.iotec.io (Uganda mobile money & card)
IOTEC_MODE=sandbox
IOTEC_CLIENT_ID=your-iotec-client-id
IOTEC_CLIENT_SECRET=your-iotec-client-secret
IOTEC_WALLET_ID=your-iotec-wallet-uuid

# Razorpay — https://razorpay.com/pricing/
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --------------------------------------------------------------------------
# Shipping carriers (optional — also configurable in Settings -> Shipping)
# Used to rate-shop, buy real labels and sync tracking. Settings saved in the
# Admin panel override these per field.
# WARNING: a live token buys real labels and is charged to your carrier account.
# --------------------------------------------------------------------------

# Shippo — https://goshippo.com (global; USPS, UPS, FedEx, DHL and 40+ more).
# Shippo has no separate sandbox host: the token decides whether a label is
# real, which is why both are stored and SHIPPO_MODE selects between them.
SHIPPO_MODE=test
SHIPPO_TEST_TOKEN=shippo_test_xxx
SHIPPO_LIVE_TOKEN=shippo_live_xxx
# Generated from Settings -> Shipping ("Generate webhook URL"); set here only
# if you prefer to manage it outside the admin panel.
SHIPPO_WEBHOOK_SECRET=

# Shiprocket — https://www.shiprocket.in (India only; dispatches from a pickup
# location NICKNAME registered in their dashboard, not from an address we send).
# There is no sandbox — any working login is a live account.
SHIPROCKET_EMAIL=api-user@example.com
SHIPROCKET_PASSWORD=your-shiprocket-api-password
SHIPROCKET_PICKUP_LOCATION=Primary
# Shared token compared against the x-api-key header on tracking webhooks.
SHIPROCKET_WEBHOOK_TOKEN=

# --------------------------------------------------------------------------
# Object storage (optional — also configurable in Settings -> Storage)
# Works with AWS S3, Cloudflare R2, or any S3-compatible provider. Settings
# saved in the Admin panel override these per field.
#   - For Cloudflare R2, set STORAGE_ENDPOINT to the R2 S3 API endpoint
#     (https://<account-id>.r2.cloudflarestorage.com) and STORAGE_REGION=auto.
#   - For AWS S3, set STORAGE_REGION (e.g. us-east-1) and leave STORAGE_ENDPOINT
#     blank.
# --------------------------------------------------------------------------
STORAGE_ACCESS_KEY_ID=your-storage-access-key-id
STORAGE_SECRET_ACCESS_KEY=your-storage-secret-access-key
STORAGE_ACCOUNT_ID=your-r2-account-id
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=your-bucket-name
# Public base URL / CDN for serving uploaded files
STORAGE_PUBLIC_URL=https://your-public-bucket-url.com
# Legacy fallback for the R2 public URL (still honoured if STORAGE_PUBLIC_URL is unset)
CLOUDFLARE_R2_PUBLIC_URL=https://your-r2-public-bucket-url.com

# --------------------------------------------------------------------------
# Analytics / tracking (optional — also configurable in Settings -> Analytics)
# These IDs are exposed to the browser for client-side tracking scripts.
# --------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=your-facebook-pixel-id
NEXT_PUBLIC_TIKTOK_PIXEL_ID=your-tiktok-pixel-id
# Plausible API key (server-side; used for the admin analytics dashboard)
PLAUSIBLE_API_KEY=your-plausible-api-key
# Optional: signed QZ Tray direct/silent thermal printing. Keep the private
# key on the server only. Use literal newlines or escaped \\n sequences.
QZ_TRAY_CERTIFICATE=""
QZ_TRAY_PRIVATE_KEY=""
