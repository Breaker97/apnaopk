    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/qz-tray": "^2.2.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/sanitize-html": "^2.16.1",
    "@types/web-push": "^3.6.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": "10.24.0"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "postcss": "^8.5.10",
    "kysely": "0.28.17",
    "sharp": "^0.35.3"
  }
