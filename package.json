    "fontkit": "^2.0.4",
    "libphonenumber-js": "^1.13.13",
    "lucide-react": "^0.562.0",
    "mongodb": "~7.5.0",
    "mongoose": "^9.9.4",
    "nanoid": "^5.1.16",
    "next": "16.3.4",
    "next-intl": "^4.14.2",
    "nodemailer": "^8.0.11",
    "openai": "^6.49.0",
    "qrcode": "^1.5.4",
