{
  "name": "Storify",
  "version": "2.2.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "NODE_OPTIONS=\"--max-old-space-size=${BUILD_NODE_HEAP_MB:-4096}\" next build",
    "start": "next start",
    "lint": "eslint --quiet",
    "typecheck": "tsc --noEmit",
    "ai-agent:replay": "tsx --env-file=.env --require ./scripts/lib/next-cache-passthrough.cjs scripts/ai-sales-agent-replay.ts",
    "probe:shiprocket": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/probe-shiprocket.ts",
    "create-admin": "node --env-file=.env scripts/create-admin.mjs",
    "link-credential": "node --env-file=.env scripts/link-credential.mjs",
    "db:seed": "tsx --env-file=.env scripts/seed.mjs",
    "db:seed:export": "node --env-file=.env scripts/export-seed-data.mjs",
    "db:seed:audit": "node scripts/audit-seed-data.mjs",
    "db:seed:audit:fix": "node scripts/audit-seed-data.mjs --fix",
    "db:seed:users": "tsx --env-file=.env scripts/seed-users.mjs",
    "db:reset": "tsx --env-file=.env scripts/reset.mjs",
    "db:full-reset": "tsx --env-file=.env scripts/reset.mjs && tsx --env-file=.env scripts/seed.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "push:keys": "web-push generate-vapid-keys"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
