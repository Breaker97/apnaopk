# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
/.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# NEXT_DIST_DIR moves the build output (second dev server, screenshot runs)
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.swp
*.pem
.codex
.worktrees/
.biz-run/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …but always ship the template
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local

# Agent tooling artifacts — local to whoever uses the tool, never shipped
.agents/
.trae/
.superpowers/
/docs/superpowers/
/CLAUDE.md

# Security audits and internal review notes — kept by the team, never shipped
/docs/security-audit-*/
/docs/audit/

# Local-storage uploads (runtime user media, served by app/uploads route)
/public/uploads/

# Vendor media written straight into public/ by local storage (banner,
# profile). Runtime user media like /public/uploads/, not source assets.
/public/images/vendors/

# Private local-storage files (digital product deliverables, never public)
/private-uploads/
